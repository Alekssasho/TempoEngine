namespace Common.Tempest;

struct Vec3 {
    x: float;
    y: float;
    z: float;
}

struct Quat {
    x: float;
    y: float;
    z: float;
    w: float;
}

struct Color {
    r: float;
    g: float;
    b: float;
    a: float;
}

enum PhysicsShapeFilter : uint {
    DrivableSurface = 0xffff0000,
    NonDrivableSurface = 0x0000ffff,
}